# Admin Credentials & Security
ADMIN_USERNAME=admin
ADMIN_PASSWORD=adminsecretpassword
ADMIN_SECRET_KEY=change-this-to-a-super-secret-key-for-jwt-signing

# LLM Providers
GOOGLE_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
GEMINI_MODEL=gemini-1.5-flash
GROQ_MODEL=llama-3.3-70b-versatile

# Pinecone Vector DB
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=pdf-qa-index
PINECONE_METRIC=dotproduct
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# Redis Stack (Semantic Cache)
REDIS_URL=redis://localhost:6379/0
CACHE_SIMILARITY_THRESHOLD=0.95
CACHE_INDEX_NAME=semantic_cache_idx

# Local Models (HuggingFace)
EMBEDDING_MODEL_NAME=BAAI/bge-base-en-v1.5
RERANKER_MODEL_NAME=BAAI/bge-reranker-base

# RAG & Ingestion Parameters
MAX_CHUNK_SIZE=1000
HYBRID_ALPHA=0.5
RETRIEVAL_TOP_K=15
RERANK_TOP_K=3
ANSWER_TIMEOUT_SECONDS=60.0
QUERY_REWRITE_TIMEOUT_SECONDS=5.0

# Database & Storage
SQLITE_DB_PATH=backend/data/pdf_qa.db
UPLOAD_DIR=backend/data/uploads
BM25_PARAMS_PATH=backend/data/bm25/bm25_params.json

# OCR Configuration
TESSERACT_CMD=tesseract
